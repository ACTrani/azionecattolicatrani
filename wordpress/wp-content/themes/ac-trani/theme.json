{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "40rem",
			"wideSize": "78rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "blu",               "name": "Blu del logo",                  "color": "#2f5d8a" },
				{ "slug": "blu-chiaro",        "name": "Blu chiaro (testo sul blu)",    "color": "#c9daec" },
				{ "slug": "notte",             "name": "Notte (inchiostro)",            "color": "#12263d" },
				{ "slug": "lime",              "name": "Lime — solo «il prossimo»",     "color": "#9bc53d" },
				{ "slug": "carta",             "name": "Carta (fondo)",                 "color": "#f7f7f2" },
				{ "slug": "foglio",            "name": "Foglio",                        "color": "#ffffff" },
				{ "slug": "tenue",             "name": "Testo tenue",                   "color": "#4a5a6e" },
				{ "slug": "filo",              "name": "Filo",                          "color": "#dcdfd6" },
				{ "slug": "filo-forte",        "name": "Filo forte",                    "color": "#b9beb2" },
				{ "slug": "errore",            "name": "Annullato",                     "color": "#b3261e" },
				{ "slug": "settore-unitario",  "name": "Cartoncino Unitario",           "color": "#2f5d8a" },
				{ "slug": "settore-adulti",    "name": "Cartoncino Adulti",             "color": "#f2b705" },
				{ "slug": "settore-giovani",   "name": "Cartoncino Giovani",            "color": "#f07a3c" },
				{ "slug": "settore-acr",       "name": "Cartoncino ACR",                "color": "#2ba3de" },
				{ "slug": "settore-msac",      "name": "Cartoncino MSAC",               "color": "#7a4fb5" },
				{ "slug": "settore-mlac",      "name": "Cartoncino MLAC",               "color": "#2e7d5b" }
			]
		},
		"typography": {
			"fluid": false,
			"defaultFontSizes": false,
			"customFontSize": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Titoli (Rubik)",
					"fontFamily": "Rubik, 'Arial Rounded MT Bold', Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Rubik",
							"fontStyle": "normal",
							"fontWeight": "500 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/caratteri/rubik-latin.woff2" ]
						},
						{
							"fontFamily": "Rubik",
							"fontStyle": "normal",
							"fontWeight": "500 900",
							"fontDisplay": "swap",
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
							"src": [ "file:./assets/caratteri/rubik-latin-ext.woff2" ]
						}
					]
				},
				{
					"slug": "corpo",
					"name": "Testo (Atkinson Hyperlegible Next)",
					"fontFamily": "'Atkinson Hyperlegible Next', 'Helvetica Neue', Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Atkinson Hyperlegible Next",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/caratteri/atkinson-next-latin.woff2" ]
						},
						{
							"fontFamily": "Atkinson Hyperlegible Next",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
							"src": [ "file:./assets/caratteri/atkinson-next-latin-ext.woff2" ]
						},
						{
							"fontFamily": "Atkinson Hyperlegible Next",
							"fontStyle": "italic",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/caratteri/atkinson-next-italic-latin.woff2" ]
						},
						{
							"fontFamily": "Atkinson Hyperlegible Next",
							"fontStyle": "italic",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
							"src": [ "file:./assets/caratteri/atkinson-next-italic-latin-ext.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "minimo",      "name": "Minimo (−2)",      "size": "clamp(0.75rem, 0.73rem + 0.08vw, 0.8rem)" },
				{ "slug": "piccolo",     "name": "Piccolo (−1)",     "size": "clamp(0.86rem, 0.83rem + 0.14vw, 0.94rem)" },
				{ "slug": "medio",       "name": "Testo (0)",        "size": "clamp(1rem, 0.96rem + 0.2vw, 1.125rem)" },
				{ "slug": "grande",      "name": "Grande (1)",       "size": "clamp(1.18rem, 1.1rem + 0.4vw, 1.42rem)" },
				{ "slug": "titolo-3",    "name": "Titolo 3 (2)",     "size": "clamp(1.4rem, 1.25rem + 0.75vw, 1.85rem)" },
				{ "slug": "titolo-2",    "name": "Titolo 2 (3)",     "size": "clamp(1.68rem, 1.42rem + 1.3vw, 2.45rem)" },
				{ "slug": "titolo-1",    "name": "Titolo 1 (4)",     "size": "clamp(2rem, 1.6rem + 2vw, 3.2rem)" },
				{ "slug": "monumentale", "name": "Monumentale (5)",  "size": "clamp(2.4rem, 1.8rem + 3vw, 4.25rem)" },
				{ "slug": "manifesto",   "name": "Manifesto (6)",    "size": "clamp(3rem, 2rem + 5vw, 6rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "em", "vh", "vw", "%" ],
			"padding": true,
			"margin": true,
			"blockGap": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "3xs", "size": "0.25rem" },
				{ "slug": "20", "name": "2xs", "size": "0.5rem" },
				{ "slug": "30", "name": "xs",  "size": "0.75rem" },
				{ "slug": "40", "name": "s — base", "size": "1rem" },
				{ "slug": "50", "name": "m",   "size": "1.5rem" },
				{ "slug": "60", "name": "l",   "size": "2.25rem" },
				{ "slug": "70", "name": "xl — sezione", "size": "3.5rem" },
				{ "slug": "80", "name": "2xl", "size": "5rem" },
				{ "slug": "90", "name": "3xl — respiro", "size": "7rem" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "foglio",      "name": "Foglio appoggiato", "shadow": "0 1px 1px rgb(18 38 61 / 0.08), 0 8px 18px -10px rgb(18 38 61 / 0.35)" },
				{ "slug": "foglio-alto", "name": "Foglio sollevato",  "shadow": "0 2px 2px rgb(18 38 61 / 0.08), 0 18px 32px -14px rgb(18 38 61 / 0.45)" }
			]
		},
		"custom": {
			"raggio": "14px",
			"raggioPiccolo": "8px",
			"larghezzaTesto": "40rem",
			"curva": "cubic-bezier(0.16, 1, 0.3, 1)",
			"transizione": "240ms cubic-bezier(0.16, 1, 0.3, 1)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--carta)",
			"text": "var(--wp--preset--color--notte)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--corpo)",
			"fontSize": "var(--wp--preset--font-size--medio)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--blu)" },
				":hover": { "color": { "text": "var(--wp--preset--color--notte)" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "1.05",
					"letterSpacing": "-0.02em"
				},
				"color": { "text": "var(--wp--preset--color--notte)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--monumentale)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--titolo-2)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--grande)", "fontWeight": "700", "letterSpacing": "-0.01em" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medio)", "fontWeight": "700" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--blu)",
					"text": "var(--wp--preset--color--foglio)"
				},
				"border": { "radius": "999px", "width": "2px", "style": "solid", "color": "var(--wp--preset--color--blu)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--piccolo)",
					"lineHeight": "1.2"
				},
				"spacing": { "padding": { "top": "0.65em", "bottom": "0.65em", "left": "1.25em", "right": "1.25em" } },
				":hover": {
					"color": { "background": "var(--wp--preset--color--notte)", "text": "var(--wp--preset--color--foglio)" },
					"border": { "color": "var(--wp--preset--color--notte)" }
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--piccolo)" },
				"color": { "text": "var(--wp--preset--color--tenue)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"fontSize": "1.3rem",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				},
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--notte)" } } }
			},
			"core/quote": {
				"typography": { "fontWeight": "700" },
				"color": { "text": "var(--wp--preset--color--tenue)" },
				"border": { "width": "0", "style": "none" },
				"spacing": { "padding": { "left": "0", "right": "0" } }
			},
			"core/separator": { "color": { "text": "var(--wp--preset--color--filo)" } },
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--piccolo)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "barra-appuntamenti", "title": "Barra dei prossimi appuntamenti", "area": "uncategorized" },
		{ "name": "header", "title": "Testata", "area": "header" },
		{ "name": "footer", "title": "Piede pagina", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "pagina-larga", "title": "Pagina a tutta larghezza", "postTypes": [ "page" ] }
	]
}

{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ac-trani/elenco-eventi",
  "title": "Elenco eventi",
  "category": "widgets",
  "icon": "calendar-alt",
  "description": "Gli appuntamenti dell'associazione come righe di calendario, con la data ritagliata. Filtrabili per settore e anno, raggruppabili per mese.",
  "keywords": ["eventi", "appuntamenti", "calendario", "ac"],
  "textdomain": "ac-trani",
  "attributes": {
    "quando":       { "type": "string",  "default": "futuri" },
    "numero":       { "type": "number",  "default": 4 },
    "salta":        { "type": "number",  "default": 0 },
    "settore":      { "type": "string",  "default": "" },
    "anno":         { "type": "string",  "default": "" },
    "evidenza":     { "type": "boolean", "default": false },
    "layout":       { "type": "string",  "default": "righe" },
    "sommario":     { "type": "boolean", "default": true },
    "perMese":      { "type": "boolean", "default": false },
    "filtri":       { "type": "boolean", "default": false },
    "titolo":       { "type": "string",  "default": "" },
    "linkArchivio": { "type": "boolean", "default": true }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": { "margin": true, "padding": true }
  },
  "editorScript": "ac-trani-blocchi",
  "viewScript": "file:./filtri.js",
  "render": "file:./render.php"
}

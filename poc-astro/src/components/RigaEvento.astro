---
/**
 * Una riga del calendario: data-ritaglio a sinistra, cosa al centro, quando e
 * dove allineati a destra, stretti al margine come i tempi di una scaletta.
 */
import type { Evento } from '../lib/contenuti';
import { settorePerSlug } from '../data/settori';
import { iso } from '../lib/date';
import { url } from '../lib/url';
import { luogoLeggibile } from '../lib/luogo';
import DataRitaglio from './DataRitaglio.astro';
import Icona from './Icona.astro';

interface Props {
  evento: Evento;
  misura?: 'piccola' | 'media';
  sommario?: boolean;
  inclinazione?: number;
}
const { evento, misura = 'media', sommario = true, inclinazione = -1.5 } = Astro.props;
const d = evento.data;
const settore = settorePerSlug(d.settore)!;
const giornoEsteso = new Intl.DateTimeFormat('it-IT', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(d.dataInizio);
---

<article class:list={['riga-evento', `riga-evento--${misura}`, { 'riga-evento--annullato': d.annullato }]} data-settore={d.settore}>
  <DataRitaglio data={d} settore={d.settore} misura={misura} inclinazione={inclinazione} />

  <div class="riga-evento__corpo">
    <h3 class="riga-evento__titolo">
      <a href={url(`/eventi/${evento.id}`)}>{d.titolo}</a>
    </h3>
    {sommario && <p class="riga-evento__sommario">{d.sommario}</p>}
    <p class="riga-evento__settore"><span class="etichetta">{settore.nome}</span></p>
    {d.annullato && <p class="riga-evento__stato">Annullato</p>}
  </div>

  <dl class="riga-evento__meta">
    <dt class="visivamente-nascosto">Quando</dt>
    <dd>
      <Icona nome="orario" dimensione={16} />
      <time datetime={iso(d.dataInizio)}>{d.dataIndicativa ?? giornoEsteso}{d.orario ? `, ${d.orario}` : ''}</time>
    </dd>
    <dt class="visivamente-nascosto">Dove</dt>
    <dd><Icona nome="luogo" dimensione={16} />{luogoLeggibile(d.luogo)}</dd>
  </dl>
</article>

<style>
  .riga-evento {
    position: relative;
    display: grid;
    grid-template-columns: var(--colonna-data, 5.6rem) minmax(0, 1fr) minmax(12rem, 17rem);
    justify-items: start;
    align-items: start;
    gap: var(--spazio-m) var(--spazio-l);
    padding: var(--spazio-m) var(--spazio-s);
    border-radius: var(--raggio);
    transition: background var(--transizione), box-shadow var(--transizione);
  }
  .riga-evento + :global(.riga-evento) { box-shadow: 0 -1px 0 var(--col-filo); }
  .riga-evento:hover { background: var(--col-foglio); box-shadow: var(--ombra-foglio); }
  .riga-evento :global(.ritaglio) { transition: rotate 320ms var(--curva), translate 320ms var(--curva); }
  .riga-evento:hover :global(.ritaglio) { rotate: 0deg; translate: 0 -2px; }

  .riga-evento__titolo { font-size: var(--step-1); margin: 0.2rem 0 0.3rem; }
  .riga-evento__settore { margin: 0.5rem 0 0; }
  .riga-evento__titolo a { color: var(--col-notte); text-decoration: none; }
  .riga-evento__titolo a::after { content: ''; position: absolute; inset: 0; border-radius: var(--raggio); }
  .riga-evento__titolo a:focus-visible { outline: none; }
  .riga-evento:has(a:focus-visible) { outline: 3px solid var(--col-blu); outline-offset: 2px; }
  .riga-evento__sommario { margin: 0; color: var(--col-tenue); font-size: var(--step--1); max-width: 36rem; }
  .riga-evento__stato {
    display: inline-block;
    margin: 0.4rem 0 0;
    padding: 0.1em 0.5em;
    border-radius: 4px;
    background: var(--col-errore);
    color: #fff;
    font-weight: 700;
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .riga-evento--annullato .riga-evento__titolo a { text-decoration: line-through; text-decoration-thickness: 2px; }

  .riga-evento__meta {
    margin: 0.2rem 0 0;
    display: grid;
    gap: 0.4rem;
    justify-items: end;
    text-align: right;
    font-size: var(--step--1);
  }
  .riga-evento__meta dd {
    margin: 0;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.4rem;
    color: var(--col-tenue);
  }
  .riga-evento__meta dd:first-of-type { color: var(--col-notte); font-weight: 700; }
  .riga-evento__meta :global(svg) { flex-shrink: 0; margin-top: 0.2em; color: var(--col-settore-su-carta); order: 2; }

  .riga-evento > :global(.ritaglio) { justify-self: center; }
  .riga-evento--piccola { --colonna-data: 4.4rem; padding-block: var(--spazio-s); gap: var(--spazio-s) var(--spazio-m); }
  .riga-evento--piccola .riga-evento__titolo { font-size: var(--step-0); margin-top: 0.1rem; }

  @media (max-width: 52rem) {
    .riga-evento { grid-template-columns: var(--colonna-data, 5.6rem) minmax(0, 1fr); gap: var(--spazio-xs) var(--spazio-s); padding-inline: var(--spazio-2xs); }
    .riga-evento__meta { grid-column: 2; justify-items: start; text-align: left; margin-top: 0; gap: 0.25rem; }
    .riga-evento__meta dd { justify-content: flex-start; }
    .riga-evento__meta :global(svg) { order: 0; }
  }
</style>

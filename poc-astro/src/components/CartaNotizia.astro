---
/**
 * Una notizia come un piccolo cartellone: il titolo scritto grande sul
 * cartoncino del settore. Funziona senza foto; quando arriveranno le immagini
 * (con liberatoria), prenderanno il posto del cartoncino.
 */
import type { Notizia } from '../lib/contenuti';
import { settorePerSlug } from '../data/settori';
import { dataEstesa, iso } from '../lib/date';
import { url } from '../lib/url';

interface Props { notizia: Notizia; grande?: boolean }
const { notizia, grande = false } = Astro.props;
const d = notizia.data;
const settore = settorePerSlug(d.settore)!;
---

<article class:list={['carta-notizia', { 'carta-notizia--grande': grande }]} data-settore={d.settore}>
  <div class="carta-notizia__cartellone">
    <h3 class="carta-notizia__titolo">
      <a href={url(`/notizie/${notizia.id}`)}>{d.titolo}</a>
    </h3>
  </div>
  <div class="carta-notizia__corpo">
    <p class="carta-notizia__alto">
      <span class="etichetta">{settore.nome}</span>
      {d.comunicato && <span class="bollo-comunicato">Comunicato</span>}
    </p>
    <p class="carta-notizia__sommario">{d.sommario}</p>
    <p class="carta-notizia__data">
      <time datetime={iso(d.data)}>{dataEstesa(d.data)}</time>
    </p>
  </div>
</article>

<style>
  .carta-notizia {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--col-foglio);
    border-radius: var(--raggio);
    box-shadow: var(--ombra-foglio);
    overflow: hidden;
    transition: box-shadow var(--transizione), translate var(--transizione);
  }
  .carta-notizia:hover { box-shadow: var(--ombra-foglio-alta); translate: 0 -3px; }
  .carta-notizia:has(a:focus-visible) { outline: 3px solid var(--col-blu); outline-offset: 3px; }

  .carta-notizia__cartellone {
    display: flex;
    align-items: flex-end;
    min-height: 10.5rem;
    padding: var(--spazio-m) var(--spazio-m) var(--spazio-s);
    background: var(--col-settore);
    color: var(--col-settore-testo);
  }
  .carta-notizia__titolo {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 800;
    line-height: 1.12;
  }
  .carta-notizia__titolo a { color: inherit; text-decoration: none; }
  .carta-notizia__titolo a:focus-visible { outline: none; }
  .carta-notizia__titolo a::after { content: ''; position: absolute; inset: 0; }

  .carta-notizia__corpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--spazio-s) var(--spazio-m) var(--spazio-m);
  }
  .carta-notizia__alto { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: var(--spazio-xs); }
  .carta-notizia__sommario { color: var(--col-tenue); font-size: var(--step--1); flex: 1; }
  .carta-notizia__data { margin: 0; font-size: var(--step--2); font-weight: 700; color: var(--col-notte); }

  .carta-notizia--grande .carta-notizia__cartellone { min-height: 15rem; padding: var(--spazio-l); }
  .carta-notizia--grande .carta-notizia__titolo { font-size: var(--step-3); }
  .carta-notizia--grande .carta-notizia__corpo { padding: var(--spazio-m) var(--spazio-l) var(--spazio-l); }
  .carta-notizia--grande .carta-notizia__sommario { font-size: var(--step-0); }
</style>

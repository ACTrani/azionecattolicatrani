---
import type { Notizia } from '../lib/contenuti';
import { settorePerSlug } from '../data/settori';
import { dataEstesa, iso } from '../lib/date';
import { url } from '../lib/url';

interface Props { notizia: Notizia }
const { notizia } = Astro.props;
const d = notizia.data;
const settore = settorePerSlug(d.settore)!;
---

<article class="carta-notizia" data-settore={d.settore}>
  <div class="carta-notizia__alto">
    <span class="etichetta">{settore.nome}</span>
    {d.comunicato && <span class="carta-notizia__bollo">Comunicato ufficiale</span>}
  </div>
  <h3 class="carta-notizia__titolo">
    <a href={url(`/notizie/${notizia.id}`)}>{d.titolo}</a>
  </h3>
  <p class="carta-notizia__sommario">{d.sommario}</p>
  <p class="carta-notizia__data">
    <time datetime={iso(d.data)}>{dataEstesa(d.data)}</time>
    {d.autore && <span> · {d.autore}</span>}
  </p>
</article>

<style>
  .carta-notizia {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--spazio-m);
    background: var(--col-carta);
    border: var(--bordo-sottile);
    border-radius: var(--raggio);
    border-top: 3px solid var(--col-settore);
    transition: transform var(--transizione), box-shadow var(--transizione);
  }
  .carta-notizia:hover { transform: translateY(-3px); box-shadow: var(--ombra-carta); }
  .carta-notizia__alto {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spazio-2xs) var(--spazio-s);
    margin-bottom: var(--spazio-s);
  }
  .carta-notizia__bollo {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25em 0.6em;
    border: 1px solid var(--col-ocra);
    color: var(--col-ocra);
    border-radius: var(--raggio);
  }
  .carta-notizia__titolo { font-size: var(--step-1); margin-bottom: var(--spazio-2xs); }
  .carta-notizia__titolo a { color: inherit; text-decoration: none; }
  .carta-notizia__titolo a::after { content: ''; position: absolute; inset: 0; }
  .carta-notizia__titolo a:hover { color: var(--col-settore); }
  .carta-notizia__sommario { color: var(--col-inchiostro-tenue); font-size: var(--step--1); flex: 1; }
  .carta-notizia__data {
    margin: var(--spazio-s) 0 0;
    padding-top: var(--spazio-2xs);
    border-top: 1px solid var(--col-bordo-tenue);
    font-size: 0.78rem;
    color: var(--col-inchiostro-tenue);
    text-transform: lowercase;
  }
</style>

---
/**
 * Icone disegnate a tratto (2px, estremità arrotondate), sullo stile di Lucide
 * (licenza ISC). Un solo set, un solo spessore in tutto il sito.
 */
interface Props {
  nome: 'freccia' | 'giu' | 'calendario' | 'luogo' | 'orario' | 'scarica' | 'cerca' | 'menu' | 'chiudi' | 'esterno' | 'posta' | 'telefono';
  dimensione?: number;
  class?: string;
}
const { nome, dimensione = 20, class: classe } = Astro.props;

const tracciati: Record<Props['nome'], string> = {
  freccia: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  giu: '<path d="m6 9 6 6 6-6"/>',
  calendario: '<rect x="3" y="4.5" width="18" height="16.5" rx="2.5"/><path d="M8 2.5v4M16 2.5v4M3 10h18"/><path d="M12 13.5v5M9.5 16h5"/>',
  luogo: '<path d="M20 10c0 5-5.5 10.2-7.4 11.8a1 1 0 0 1-1.2 0C9.5 20.2 4 15 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
  orario: '<circle cx="12" cy="12" r="9.5"/><path d="M12 7v5l3 2"/>',
  scarica: '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>',
  cerca: '<circle cx="11" cy="11" r="7"/><path d="m20.5 20.5-4.5-4.5"/>',
  menu: '<path d="M4 6.5h16M4 12h16M4 17.5h16"/>',
  chiudi: '<path d="M6 6l12 12M18 6 6 18"/>',
  esterno: '<path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  posta: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  telefono: '<path d="M21 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 1.1 4.2 2 2 0 0 1 3.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L7 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
};
---
<svg
  class={classe}
  width={dimensione}
  height={dimensione}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={tracciati[nome]}
/>

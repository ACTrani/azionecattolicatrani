---
import Base from '../layouts/Base.astro';
import TestaPagina from '../components/TestaPagina.astro';
import Icona from '../components/Icona.astro';
import { sito } from '../data/sito';
import { settorePerSlug } from '../data/settori';
import { icona, lettera, paroleAnno, laboratorio, cammini, appuntamentiNazionali } from '../data/programmazione';
import { url } from '../lib/url';
---

<Base
  titolo={`Programmazione ${sito.annoAssociativo}`}
  descrizione={`Il cammino dell'anno associativo ${sito.annoAssociativo}: l'icona biblica «${icona.titolo}», il Laboratorio diocesano della formazione e le proposte dei settori.`}
>
  <TestaPagina titolo={icona.titolo} briciole={[{ testo: `Programmazione ${sito.annoAssociativo}`, href: url('/programmazione') }]}>
    <blockquote class="citazione">
      <p>{icona.citazione}</p>
      <cite>{icona.citazioneRiferimento}</cite>
    </blockquote>
  </TestaPagina>

  <div class="contenitore">
    <section class="sezione due-colonne">
      <h2>L'icona biblica</h2>
      <div class="testo-lungo">{icona.testo.map((p) => <p>{p}</p>)}</div>
    </section>

    <section class="sezione due-colonne filo">
      <h2>Dalla lettera della Presidente</h2>
      <div class="testo-lungo lettera">
        {lettera.paragrafi.map((p) => <p>{p}</p>)}
        <p class="lettera__firma">{lettera.firma}<br /><span>{lettera.ruolo}</span></p>
      </div>
    </section>

    <section class="sezione filo" aria-labelledby="titolo-parole">
      <h2 id="titolo-parole" class="titolo-blocco">Le parole dell'anno</h2>
      <div class="parole">
        {paroleAnno.map((p) => {
          const [chiave, valore] = p.nome.split(': ');
          return (
            <article class="parola">
              <p class="parola__chiave">{chiave}</p>
              <h3>{valore ?? p.nome}</h3>
              <p>{p.testo}</p>
            </article>
          );
        })}
      </div>
    </section>

    <section class="sezione filo" aria-labelledby="titolo-laboratorio">
      <h2 id="titolo-laboratorio" class="titolo-blocco">Il Laboratorio diocesano della formazione</h2>
      <p class="intro">Il percorso formativo di tutta l'associazione, in tre passaggi collegati fra loro. Referente: {laboratorio.referente}.</p>
      <ol class="passaggi">
        {laboratorio.passaggi.map((p) => (
          <li class="passaggio">
            <h3>{p.titolo}</h3>
            <p class="passaggio__domanda">«{p.domanda}»</p>
            <p>{p.testo}</p>
            <p class="passaggio__quando">
              {p.evento ? <a href={url(`/eventi/${p.evento}`)}>{p.quando}</a> : p.quando}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="sezione filo" aria-labelledby="titolo-cammini">
      <h2 id="titolo-cammini" class="titolo-blocco">I cammini dei settori</h2>
      <div class="cammini">
        {cammini.map((c) => {
          const settore = settorePerSlug(c.settore)!;
          return (
            <article class="cammino" data-settore={c.settore}>
              <div class="cammino__testa">
                <span class="etichetta">{settore.nome}</span>
                <h3>{c.titolo}</h3>
                <p>{c.sottotitolo}</p>
              </div>
              <div class="cammino__corpo">
                {c.paragrafi.map((p) => <p>{p}</p>)}
                {c.punti && <ul>{c.punti.map((p) => <li>{p}</li>)}</ul>}
                <a class="cammino__link" href={url(`/settori/${c.settore}`)}>La pagina del settore <Icona nome="freccia" dimensione={16} /></a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="sezione due-colonne filo">
      <h2>Appuntamenti e proposte nazionali</h2>
      <ul class="testo-lungo nazionali">{appuntamentiNazionali.map((a) => <li>{a}</li>)}</ul>
    </section>

    <div class="azioni">
      <a class="bottone" href={url('/eventi')}>Tutti gli appuntamenti dell'anno</a>
      <a class="bottone bottone--vuoto" href={url('/calendario.ics')}><Icona nome="calendario" dimensione={18} /> Iscriviti al calendario</a>
    </div>
  </div>
</Base>

<style>
  .citazione { margin: 0; max-width: 42rem; }
  .citazione p { font-size: var(--step-1); color: #fff; margin-bottom: 0.4rem; }
  .citazione cite { font-style: normal; font-weight: 700; }

  .filo { border-top: 2px solid var(--col-notte); }
  .due-colonne { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: var(--spazio-xl); }
  .due-colonne > h2 { font-size: var(--step-3); }
  .titolo-blocco { font-size: var(--step-4); margin-bottom: var(--spazio-l); }
  .intro { max-width: var(--larghezza-testo); color: var(--col-tenue); margin-top: calc(var(--spazio-m) * -1); margin-bottom: var(--spazio-l); }

  .lettera p:first-child { font-size: var(--step-1); font-weight: 700; line-height: 1.45; }
  .lettera__firma { font-weight: 700; margin-top: var(--spazio-m); }
  .lettera__firma span { font-weight: 400; color: var(--col-tenue); }

  .parole { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--spazio-m); }
  .parola { padding: var(--spazio-m); background: var(--col-blu); color: #fff; border-radius: var(--raggio); }
  .parola__chiave { font-size: var(--step--1); font-weight: 700; color: var(--col-blu-chiaro); margin-bottom: 0.2rem; }
  .parola h3 { font-size: var(--step-2); font-weight: 900; }
  .parola p:last-child { font-size: var(--step--1); color: var(--col-blu-chiaro); margin: 0; }

  .passaggi { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spazio-m); }
  .passaggio { padding: var(--spazio-m); background: var(--col-foglio); border-radius: var(--raggio); box-shadow: var(--ombra-foglio); font-size: var(--step--1); }
  .passaggio h3 { font-size: var(--step-1); }
  .passaggio__domanda { font-weight: 700; color: var(--col-blu); font-size: var(--step-0); }
  .passaggio__quando { font-weight: 700; margin: 0; }

  .cammini { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--spazio-m); }
  .cammino { display: flex; flex-direction: column; background: var(--col-foglio); border-radius: var(--raggio); box-shadow: var(--ombra-foglio); overflow: hidden; }
  .cammino__testa { padding: var(--spazio-m); background: var(--col-settore); color: var(--col-settore-testo); }
  .cammino__testa .etichetta { background: var(--col-foglio); color: var(--col-settore-su-carta); }
  .cammino__testa h3 { font-size: var(--step-2); font-weight: 900; margin: var(--spazio-xs) 0 0.25rem; }
  .cammino__testa p { margin: 0; font-weight: 700; }
  .cammino__corpo { display: flex; flex-direction: column; flex: 1; padding: var(--spazio-m); font-size: var(--step--1); }
  .cammino__corpo ul { padding-left: 1.1rem; }
  .cammino__link { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: auto; padding-top: var(--spazio-s); font-weight: 700; }

  .nazionali { padding-left: 1.2rem; }
  .azioni { display: flex; flex-wrap: wrap; gap: var(--spazio-s); padding-top: var(--spazio-l); }

  @media (max-width: 62rem) {
    .parole { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .passaggi, .cammini { grid-template-columns: 1fr; }
    .due-colonne { grid-template-columns: 1fr; gap: var(--spazio-s); }
  }
  @media (max-width: 34rem) { .parole { grid-template-columns: 1fr; } }
</style>

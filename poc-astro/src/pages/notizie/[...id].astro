---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CartaNotizia from '../../components/CartaNotizia.astro';
import Icona from '../../components/Icona.astro';
import { tutteLeNotizie } from '../../lib/contenuti';
import { settorePerSlug } from '../../data/settori';
import { dataEstesa, iso } from '../../lib/date';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const notizie = await tutteLeNotizie();
  return notizie.map((notizia, i) => ({
    params: { id: notizia.id },
    props: { notizia, piuRecente: notizie[i - 1], menoRecente: notizie[i + 1], altre: notizie.filter((n) => n.id !== notizia.id).slice(0, 3) },
  }));
}

const { notizia, piuRecente, menoRecente, altre } = Astro.props;
const d = notizia.data;
const settore = settorePerSlug(d.settore)!;
const { Content } = await render(notizia);
---

<Base titolo={d.titolo} descrizione={d.sommario}>
  <article class="articolo" data-settore={d.settore}>
    <header class="cartellone">
      <div class="contenitore cartellone__riga">
        <nav aria-label="Sei qui" class="briciole">
          <a href={url('/notizie')}>Notizie</a> / <span>{settore.nome}</span>
        </nav>
        <h1>{d.titolo}</h1>
      </div>
    </header>

    <div class="contenitore">
      <div class="foglio">
        <p class="foglio__meta">
          <span class="etichetta">{settore.nome}</span>
          {d.comunicato && <span class="bollo-comunicato">Comunicato ufficiale</span>}
          <time datetime={iso(d.data)}>{dataEstesa(d.data)}</time>
          {d.autore && <span>{d.autore}</span>}
        </p>
        <p class="foglio__sommario">{d.sommario}</p>
        <div class="testo-lungo"><Content /></div>
      </div>

      <nav class="sfoglia" aria-label="Altre notizie">
        {menoRecente ? (
          <a href={url(`/notizie/${menoRecente.id}`)} class="sfoglia__voce">
            <span>Precedente</span>{menoRecente.data.titolo}
          </a>
        ) : <span />}
        {piuRecente && (
          <a href={url(`/notizie/${piuRecente.id}`)} class="sfoglia__voce sfoglia__voce--dopo">
            <span>Successiva</span>{piuRecente.data.titolo}
          </a>
        )}
      </nav>
    </div>
  </article>

  <section class="contenitore correlate" aria-labelledby="titolo-correlate">
    <div class="testa-sezione">
      <h2 id="titolo-correlate">Altre notizie</h2>
      <a class="testa-sezione__link" href={url('/notizie')}>Tutte <Icona nome="freccia" dimensione={18} /></a>
    </div>
    <div class="correlate__griglia">
      {altre.map((n) => <CartaNotizia notizia={n} />)}
    </div>
  </section>
</Base>

<style>
  .cartellone { background: var(--col-settore); color: var(--col-settore-testo); }
  .cartellone__riga { padding-block: var(--spazio-xl) calc(var(--spazio-2xl) + var(--spazio-l)); }
  .cartellone h1 { font-size: var(--step-5); font-weight: 900; letter-spacing: -0.03em; max-width: 20ch; margin: 0; }
  .briciole { font-size: var(--step--1); font-weight: 700; margin-bottom: var(--spazio-m); }
  .briciole a { color: inherit; }

  .foglio {
    max-width: 50rem;
    margin: calc(var(--spazio-2xl) * -1) auto 0;
    padding: var(--spazio-xl);
    background: var(--col-foglio);
    border-radius: var(--raggio);
    box-shadow: var(--ombra-foglio-alta);
    position: relative;
  }
  .foglio__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--col-tenue);
    margin-bottom: var(--spazio-m);
  }
  .foglio__sommario { font-size: var(--step-1); line-height: 1.45; font-weight: 700; max-width: var(--larghezza-testo); }

  .sfoglia {
    max-width: 50rem;
    margin: var(--spazio-l) auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spazio-m);
  }
  .sfoglia__voce {
    display: grid;
    gap: 0.2rem;
    font-family: var(--testo-display);
    font-weight: 700;
    color: var(--col-notte);
    text-decoration: none;
  }
  .sfoglia__voce span { font-family: var(--testo-corpo); font-size: var(--step--2); color: var(--col-tenue); text-transform: uppercase; letter-spacing: 0.08em; }
  .sfoglia__voce:hover { color: var(--col-blu); }
  .sfoglia__voce--dopo { text-align: right; }

  .correlate { padding-top: var(--spazio-2xl); }
  .correlate .testa-sezione h2 { font-size: var(--step-3); }
  .correlate__griglia { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spazio-m); }

  @media (max-width: 48rem) {
    .foglio { padding: var(--spazio-m); margin-top: calc(var(--spazio-xl) * -1); }
    .correlate__griglia { grid-template-columns: 1fr; }
    .sfoglia { grid-template-columns: 1fr; }
    .sfoglia__voce--dopo { text-align: left; }
  }
</style>

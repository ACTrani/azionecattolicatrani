---
import Base from '../../layouts/Base.astro';
import TestaPagina from '../../components/TestaPagina.astro';
import CartaNotizia from '../../components/CartaNotizia.astro';
import { tutteLeNotizie } from '../../lib/contenuti';

const notizie = await tutteLeNotizie();
const comunicati = notizie.filter((n) => n.data.comunicato);
---

<Base
  titolo="Notizie"
  descrizione="Notizie dalla vita associativa e comunicati ufficiali della Presidenza diocesana."
>
  <TestaPagina titolo="Notizie">
    <p>Le notizie dalla vita dell'associazione e i comunicati ufficiali della Presidenza diocesana.</p>
    <div slot="sotto" class="filtri" role="group" aria-label="Mostra">
      <button class="filtro" type="button" data-vista="tutte" aria-pressed="true">Tutte ({notizie.length})</button>
      <button class="filtro" type="button" data-vista="comunicati" aria-pressed="false">Solo comunicati ufficiali ({comunicati.length})</button>
    </div>
  </TestaPagina>

  <div class="contenitore griglia">
    {notizie.map((n, i) => (
      <div class="voce" data-comunicato={n.data.comunicato ? 'si' : 'no'}>
        <CartaNotizia notizia={n} grande={i === 0} />
      </div>
    ))}
  </div>
  <p class="contenitore nota-prototipo"><strong>Prototipo:</strong> le notizie sono testi di esempio, da sostituire con quelle vere della Presidenza.</p>
</Base>

<script>
  const bottoni = document.querySelectorAll<HTMLButtonElement>('.filtro');
  const voci = document.querySelectorAll<HTMLElement>('.voce');
  bottoni.forEach((b) =>
    b.addEventListener('click', () => {
      const soloComunicati = b.dataset.vista === 'comunicati';
      voci.forEach((v) => (v.hidden = soloComunicati && v.dataset.comunicato !== 'si'));
      bottoni.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }),
  );
</script>

<style>
  .filtri { display: flex; flex-wrap: wrap; gap: 0.4rem; padding-block: var(--spazio-s); }
  .filtro {
    min-height: 2.6rem;
    padding: 0.4em 1em;
    border: 2px solid rgb(255 255 255 / 0.55);
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font: 700 var(--step--1) / 1 var(--testo-display);
    cursor: pointer;
  }
  .filtro[aria-pressed='true'] { background: #fff; border-color: #fff; color: var(--col-blu); }
  .filtro:focus-visible { outline-color: #fff; }

  .griglia {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spazio-m);
    padding-top: var(--spazio-xl);
  }
  .voce { display: flex; }
  .voce > :global(*) { flex: 1; }
  .voce:first-child { grid-column: span 2; }
  @media (max-width: 62rem) { .griglia { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) {
    .griglia { grid-template-columns: 1fr; }
    .voce:first-child { grid-column: auto; }
  }
</style>

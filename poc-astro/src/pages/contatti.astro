---
import Base from '../layouts/Base.astro';
import TestaPagina from '../components/TestaPagina.astro';
import Icona from '../components/Icona.astro';
import { sito } from '../data/sito';

const mappa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${sito.contatti.sede}, ${sito.contatti.comune}`)}`;
---

<Base titolo="Contatti" descrizione="Come raggiungere la segreteria diocesana dell'Azione Cattolica.">
  <TestaPagina titolo="Contatti">
    <p>La segreteria diocesana risponde a parrocchie, educatori e famiglie.</p>
  </TestaPagina>

  <div class="contenitore">
    <div class="schede">
      <section class="scheda scheda--blu" aria-labelledby="titolo-segreteria">
        <h2 id="titolo-segreteria">Segreteria diocesana</h2>
        <address>{sito.contatti.sede}<br />{sito.contatti.comune}</address>
        <p class="orari"><Icona nome="orario" dimensione={18} />{sito.contatti.orari}</p>
        <a class="bottone bottone--chiaro" href={mappa} rel="noopener noreferrer" target="_blank"><Icona nome="luogo" dimensione={18} /> Apri la mappa</a>
      </section>

      <section class="scheda" aria-labelledby="titolo-scrivi">
        <h2 id="titolo-scrivi">Scrivi o chiama</h2>
        <ul class="recapiti">
          <li><a href={`mailto:${sito.contatti.email}`}><Icona nome="posta" />{sito.contatti.email}</a></li>
          <li><a href={`tel:${sito.contatti.telefonoHref}`}><Icona nome="telefono" />{sito.contatti.telefono}</a></li>
        </ul>
      </section>

      <section class="scheda" aria-labelledby="titolo-social">
        <h2 id="titolo-social">Seguici</h2>
        <ul class="recapiti">
          {sito.social.map((s) => (
            <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.nome}<Icona nome="esterno" dimensione={16} /></a></li>
          ))}
        </ul>
      </section>
    </div>

    <p class="nota-prototipo">
      <strong>Da confermare:</strong> recapiti e orari sono ripresi dalla scheda diocesana sul portale nazionale; i profili social sono
      quelli nazionali e vanno sostituiti con i canali diocesani.
    </p>
  </div>
</Base>

<style>
  .schede {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: var(--spazio-m);
    margin-top: calc(var(--spazio-l) * -1);
  }
  .scheda { padding: var(--spazio-l); background: var(--col-foglio); border-radius: var(--raggio); box-shadow: var(--ombra-foglio-alta); }
  .scheda h2 { font-size: var(--step-2); }
  .scheda--blu { background: var(--col-notte); color: #fff; }
  .scheda--blu h2 { color: #fff; }
  address { font-style: normal; font-size: var(--step-1); font-weight: 700; line-height: 1.5; margin-bottom: var(--spazio-s); }
  .orari { display: flex; gap: 0.45rem; align-items: flex-start; color: #c6d3e1; margin-bottom: var(--spazio-m); }
  .orari :global(svg) { flex-shrink: 0; margin-top: 0.2em; color: var(--col-blu-chiaro); }
  .recapiti { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--spazio-s); }
  .recapiti a { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: var(--step-0); overflow-wrap: anywhere; }
  @media (max-width: 58rem) { .schede { grid-template-columns: 1fr; } }
</style>

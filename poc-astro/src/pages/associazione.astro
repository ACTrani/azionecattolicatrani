---
import Base from '../layouts/Base.astro';
import TestaPagina from '../components/TestaPagina.astro';
import Icona from '../components/Icona.astro';
import { sito } from '../data/sito';
import { settoriInOrdine } from '../data/navigazione';
import { centroStudi } from '../data/programmazione';
import { url } from '../lib/url';
---

<Base
  titolo="Chi siamo"
  descrizione="Chi siamo, come siamo organizzati e quali sono i settori dell'Azione Cattolica nell'Arcidiocesi di Trani – Barletta – Bisceglie."
>
  <TestaPagina titolo="Chi siamo">
    <p>Un'associazione di laici che scelgono di servire la Chiesa locale in modo stabile e organizzato, camminando insieme al vescovo e alla comunità diocesana.</p>
  </TestaPagina>

  <div class="contenitore">
    <section class="sezione due-colonne">
      <h2>L'Azione Cattolica in diocesi</h2>
      <div class="testo-lungo">
        <p>
          Nell'Arcidiocesi di Trani – Barletta – Bisceglie l'associazione è presente nelle
          parrocchie delle tre città con gruppi di ragazzi, giovani e adulti. Ogni
          associazione parrocchiale è autonoma nella vita quotidiana e si riconosce in un
          cammino diocesano comune, scandito dalla programmazione annuale e dagli
          appuntamenti unitari.
        </p>
        <p>
          L'anno associativo si apre a settembre con l'assemblea diocesana e si chiude in
          estate con i campi scuola. Nel mezzo: formazione, servizio, spiritualità e
          impegno nella città.
        </p>
        <p>
          Quest'anno il cammino è guidato dall'icona biblica «{sito.temaAnno}»
          ({sito.temaAnnoRiferimento}) e dal verbo <em>generare</em>:
          <a href={url('/programmazione')}>leggi la programmazione {sito.annoAssociativo}</a>.
        </p>
      </div>
    </section>

    <section class="sezione filo" aria-labelledby="titolo-settori">
      <h2 id="titolo-settori" class="titolo-blocco">Sei strade, una sola associazione</h2>
      <ul class="settori">
        {settoriInOrdine.map((s) => (
          <li data-settore={s.slug}>
            <a href={url(`/settori/${s.slug}`)}>
              <span class="settori__nome">{s.nomeEsteso}</span>
              <span class="settori__eta">{s.eta}</span>
              <span class="settori__testo">{s.descrizione}</span>
              <span class="settori__vai">La pagina del settore <Icona nome="freccia" dimensione={16} /></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="centro-studi" class="sezione due-colonne filo">
      <div>
        <h2>{centroStudi.nome}</h2>
        <p class="sotto">{centroStudi.sottotitolo}</p>
      </div>
      <div class="testo-lungo">
        <p>{centroStudi.introduzione}</p>
        <ul>{centroStudi.proposte.map((p) => <li>{p}</li>)}</ul>
        <p>Per contatti: {centroStudi.referente}, <a href={`mailto:${centroStudi.email}`}>{centroStudi.email}</a></p>
        <ul class="collegamenti">
          {centroStudi.collegamenti.map((c) => (
            <li><a href={c.url} rel="noopener noreferrer" target="_blank">{c.nome} <Icona nome="esterno" dimensione={14} /></a></li>
          ))}
        </ul>
      </div>
    </section>

    <p class="nota-prototipo"><strong>Da rileggere:</strong> il testo di presentazione è provvisorio e va sostituito con quello della Presidenza.</p>
  </div>
</Base>

<style>
  .filo { border-top: 2px solid var(--col-notte); }
  .due-colonne { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: var(--spazio-xl); }
  .due-colonne h2 { font-size: var(--step-3); }
  .sotto { color: var(--col-blu); font-weight: 700; }
  .titolo-blocco { font-size: var(--step-4); margin-bottom: var(--spazio-l); }

  .settori { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spazio-m); }
  .settori a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--spazio-m);
    background: var(--col-settore);
    color: var(--col-settore-testo);
    border-radius: var(--raggio);
    box-shadow: var(--ombra-foglio);
    text-decoration: none;
    transition: translate var(--transizione), box-shadow var(--transizione);
  }
  .settori a:hover { translate: 0 -4px; box-shadow: var(--ombra-foglio-alta); }
  .settori__nome { font-family: var(--testo-display); font-weight: 900; font-size: var(--step-2); line-height: 1.05; }
  .settori__eta { font-weight: 700; font-size: var(--step--1); margin: 0.35rem 0 var(--spazio-s); }
  .settori__testo { font-size: var(--step--1); flex: 1; }
  .settori__vai { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: var(--spazio-s); font-weight: 700; font-size: var(--step--1); }

  .collegamenti { list-style: none; padding: 0 !important; display: flex; flex-wrap: wrap; gap: var(--spazio-s) var(--spazio-m); }
  .collegamenti a { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 700; }

  @media (max-width: 62rem) { .settori { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 52rem) { .due-colonne { grid-template-columns: 1fr; gap: var(--spazio-s); } }
  @media (max-width: 34rem) { .settori { grid-template-columns: 1fr; } }
</style>

---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TestaPagina from '../../components/TestaPagina.astro';
import DataRitaglio from '../../components/DataRitaglio.astro';
import RigaEvento from '../../components/RigaEvento.astro';
import Icona from '../../components/Icona.astro';
import { tuttiGliEventi, eventiProssimi } from '../../lib/contenuti';
import { settorePerSlug } from '../../data/settori';
import { quando, dataConGiorno, iso } from '../../lib/date';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const eventi = await tuttiGliEventi();
  return eventi.map((evento) => ({ params: { id: evento.id }, props: { evento } }));
}

const { evento } = Astro.props;
const d = evento.data;
const settore = settorePerSlug(d.settore)!;
const { Content } = await render(evento);
const prossimi = await eventiProssimi();
const ilProssimo = prossimi[0]?.id === evento.id;
const altri = prossimi.filter((e) => e.data.settore === d.settore && e.id !== evento.id).slice(0, 3);
const mappa = d.luogo.mappaUrl ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([d.luogo.nome, d.luogo.indirizzo, d.luogo.comune].filter(Boolean).join(', '))}`;
const luogoNoto = !/da definire/i.test(d.luogo.nome);
---

<Base titolo={d.titolo} descrizione={d.sommario}>
  <TestaPagina
    titolo={d.titolo}
    settore={d.settore}
    briciole={[{ testo: 'Eventi', href: url('/eventi') }, { testo: settore.nome, href: `${url('/eventi')}?settore=${d.settore}` }]}
  >
    <p>{d.sommario}</p>
    {d.annullato && <p class="annullato">Questo appuntamento è stato annullato.</p>}
  </TestaPagina>

  <div class="contenitore corpo">
    <aside class="scheda" aria-label="In breve">
      <DataRitaglio data={d} settore={d.settore} misura="media" prossimo={ilProssimo} dicitura={ilProssimo ? 'Il prossimo' : undefined} inclinazione={-3} />
      <dl class="scheda__dati">
        <div>
          <dt><Icona nome="orario" dimensione={18} />Quando</dt>
          <dd>
            <time datetime={iso(d.dataInizio)}>{d.dataFine || d.dataIndicativa ? quando(d) : dataConGiorno(d.dataInizio)}</time>
            {d.orario && <><br />{d.orario}</>}
          </dd>
        </div>
        <div>
          <dt><Icona nome="luogo" dimensione={18} />Dove</dt>
          <dd>
            {luogoNoto ? d.luogo.nome : `${d.luogo.comune} — sede da definire`}
            {d.luogo.indirizzo && <><br />{d.luogo.indirizzo}</>}
            {luogoNoto && <><br />{d.luogo.comune}</>}
            {luogoNoto && <><br /><a href={mappa} rel="noopener noreferrer" target="_blank">Apri la mappa</a></>}
          </dd>
        </div>
        <div>
          <dt>Per chi</dt>
          <dd>{settore.nomeEsteso} · anno {d.annoAssociativo}</dd>
        </div>
      </dl>
      <div class="scheda__azioni">
        {d.dataIndicativa ? (
          <p class="scheda__nota">La data non è ancora fissata: l'evento entrerà nel calendario appena sarà decisa.</p>
        ) : (
          <a class="bottone" href={url(`/eventi/${evento.id}.ics`)}><Icona nome="calendario" dimensione={18} /> Aggiungi al calendario</a>
        )}
        {d.linkIscrizione && (
          <a class="bottone bottone--vuoto" href={d.linkIscrizione} rel="noopener noreferrer" target="_blank">Iscriviti <Icona nome="esterno" dimensione={16} /></a>
        )}
      </div>
    </aside>

    <div class="testo-lungo" data-settore={d.settore}>
      <Content />
    </div>
  </div>

  {altri.length > 0 && (
    <section class="contenitore altri" aria-labelledby="titolo-altri">
      <div class="testa-sezione">
        <h2 id="titolo-altri">Altri appuntamenti {settore.nome}</h2>
        <a class="testa-sezione__link" href={url(`/settori/${d.settore}`)}>Il settore <Icona nome="freccia" dimensione={18} /></a>
      </div>
      <div class="altri__elenco">
        {altri.map((e, i) => <RigaEvento evento={e} sommario={false} misura="piccola" inclinazione={i % 2 ? 1.5 : -1.5} />)}
      </div>
    </section>
  )}
</Base>

<style>
  .annullato {
    display: inline-block;
    margin-top: var(--spazio-s);
    padding: 0.4em 0.9em;
    border-radius: var(--raggio-piccolo);
    background: var(--col-errore);
    color: #fff;
    font-weight: 700;
  }

  .corpo {
    display: grid;
    grid-template-columns: 21rem minmax(0, 1fr);
    gap: var(--spazio-2xl);
    align-items: start;
    padding-block: var(--spazio-xl);
  }
  .scheda {
    position: sticky;
    top: 7.5rem;
    margin-top: calc(var(--spazio-2xl) * -1);
    padding: var(--spazio-m);
    background: var(--col-foglio);
    border-radius: var(--raggio);
    box-shadow: var(--ombra-foglio-alta);
  }
  .scheda__dati { margin: var(--spazio-m) 0 0; display: grid; gap: var(--spazio-s); }
  .scheda__dati div { padding-bottom: var(--spazio-s); border-bottom: 1px solid var(--col-filo); }
  .scheda__dati dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--col-tenue);
    margin-bottom: 0.2rem;
  }
  .scheda__dati dt :global(svg) { color: var(--col-settore-su-carta); }
  .scheda__dati dd { margin: 0; font-weight: 700; }
  .scheda__dati dd a { font-weight: 700; font-size: var(--step--1); }
  .scheda__azioni { display: grid; gap: var(--spazio-2xs); margin-top: var(--spazio-m); }
  .scheda__nota { margin: 0; font-size: var(--step--1); color: var(--col-tenue); }

  .altri { padding-block: var(--spazio-xl) 0; }
  .altri .testa-sezione h2 { font-size: var(--step-3); }
  .altri__elenco { margin-inline: calc(var(--spazio-s) * -1); }

  @media (max-width: 58rem) {
    .corpo { grid-template-columns: 1fr; gap: var(--spazio-xl); }
    .scheda { position: static; margin-top: calc(var(--spazio-xl) * -1); }
  }
</style>

textarea {
	font-family: verdana,arial,helvetica,sans-serif;
	font-size: 10px;
	color: #000000;
	background-color: #F1F2F7;
	border: 1px solid #000000;
	width: 100%;
}
	
.codetable {
	background-color:#ffffff; 
	border:1px solid black;
}

iframe {
	font-family: verdana, arial, helvetica, sans-serif; 
	font-size: 10px; 
	color: #000000; 
	background-color: #F1F2F7; 
	border: 2px solid #496c9f;	
	width: 100%;
}
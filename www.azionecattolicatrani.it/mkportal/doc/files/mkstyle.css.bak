.navtitle {
	font-family:verdana,arial,helvetica,sans-serif; 
	font-size:14px; 
	color:#9D060F; 
	text-align:left; 
	font-weight:bold;	
}


.nav ul, .nav li {
	list-style: none;
	font-family:verdana,arial,helvetica,sans-serif; 
	font-size:12px; 
	/*color:#000000;*/ 
	/*text-align: justify;*/ 
	padding-bottom:5px;
	margin-left: 0;
	padding-left: 1em;
	text-indent: -3em;
	
	
	
	
	
}

